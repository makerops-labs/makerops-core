# ─── llama.cpp — llama-server router mode ────────────────────────────────────
# Requires NVIDIA Container Toolkit on the host before starting.
# See: ai/README.md for prerequisite installation instructions.
# Docs: https://github.com/ggml-org/llama.cpp/tree/master/tools/server

# ─── Model files ─────────────────────────────────────────────────────────────
# Host directory holding the GGUF files, mounted read-only at /models.
# Keep it OUTSIDE the repo (GGUFs are 10+ GB each). Replace <user> with your
# username. Every `model = /models/<file>.gguf` line in models.ini must exist here.
LLAMACPP_MODELS_DIR=/home/<user>/models/gguf

# ─── Port ────────────────────────────────────────────────────────────────────
# Host port for the OpenAI-compatible API (container port is always 8080).
# Must match LLAMACPP_PORT in infrastructure/name-proxy/.env if you change it.
LLAMACPP_PORT=8110
