# ── Docker bind-mount data directories ───────────────────────────────────────
# These are created at runtime and must never be committed.
**/db_data/
**/config/
**/data/
**/registry/

# ── Environment files (belt-and-suspenders; each service dir has its own) ────
**/.env

# ── Local-only name-proxy drop-ins (never tracked) ────────────────────────────
infrastructure/name-proxy/nginx/templates/local-*.conf.template
infrastructure/name-proxy/html/local-*.json
infrastructure/name-proxy/html/local-icons/

# ── Environment sync (gist clone and config) ──────────────────────────────────
.envs-gist/
.envs-gist.conf

# ── OS / editor artifacts ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
