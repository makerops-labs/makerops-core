# ─── draw.io — Self-hosted diagramming ────────────────────────────────────────
# See: https://github.com/jgraph/docker-drawio

# ─── Image ────────────────────────────────────────────────────────────────────
# Pin to a specific release tag for reproducibility.
# See: https://hub.docker.com/r/jgraph/drawio/tags
DRAWIO_VERSION=latest

# ─── Application ──────────────────────────────────────────────────────────────
# Must match the address used to reach draw.io from the browser.
# Update both values if you change the host port or access draw.io via a
# named subdomain (e.g., http://draw.central.home).
DRAWIO_BASE_URL=http://localhost:8085
DRAWIO_SERVER_URL=http://localhost:8085/

# Port exposed on the host. Rarely needs changing.
#DRAWIO_PORT_HOST=8085

# ─── Cloud storage integrations (optional) ────────────────────────────────────
# Uncomment and fill in to enable saving diagrams to Google Drive or OneDrive.
#DRAWIO_GOOGLE_CLIENT_ID=
#DRAWIO_GOOGLE_CLIENT_SECRET=
#DRAWIO_MSGRAPH_CLIENT_ID=
#DRAWIO_MSGRAPH_CLIENT_SECRET=
